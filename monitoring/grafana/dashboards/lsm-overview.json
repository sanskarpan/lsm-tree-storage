      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "lsm_engine_memtable_size_bytes{job=\"lsm-storage\"}",
          "legendFormat": "Memtable size",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "lsm_engine_immutables{job=\"lsm-storage\"}",
          "legendFormat": "Immutable memtables",
          "refId": "B"
