# Pin with digest for reproducible builds.
# Update digest when upgrading: docker pull golang:1.26.5-alpine && docker inspect --format='{{index .RepoDigests 0}}' golang:1.26.5-alpine
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/lsm-server ./cmd/server

# Pin with digest for reproducible builds.
# Update digest when upgrading: docker pull alpine:3.22 && docker inspect --format='{{index .RepoDigests 0}}' alpine:3.22
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

RUN addgroup -S lsm && adduser -S -G lsm lsm
WORKDIR /app

COPY --from=build /out/lsm-server /usr/local/bin/lsm-server
COPY config.yaml /app/config.yaml

RUN mkdir -p /app/data && chown -R lsm:lsm /app

USER lsm

ENV ADDR=0.0.0.0:8080
ENV CONFIG_PATH=/app/config.yaml
ENV DATA_DIR=/app/data

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/lsm-server"]
