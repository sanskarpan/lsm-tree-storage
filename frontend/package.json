{
  "name": "frontend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:client": "vite build --config vite.config.ts",
    "dev:client": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run index.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:stats": "vite build --config vite.config.ts && vite-bundle-visualizer --config vite.config.ts --output dist/stats.html",
    "bundle:check": "vite build --config vite.config.ts && bun run scripts/check-bundle-budget.ts"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@storybook/addon-essentials": "^8",
    "@storybook/addon-themes": "^8",
    "@storybook/blocks": "^8",
    "@storybook/react": "^8",
    "@storybook/react-vite": "^8",
    "@storybook/test": "^8",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/bun": "latest",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jest-axe": "^10.0.0",
    "jest-extended": "^7.0.0",
    "jsdom": "^25",
    "storybook": "^8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^3"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "brace-expansion": ">=2.1.2",
    "form-data": ">=4.0.6",
    "vite": ">=6.4.3",
    "esbuild": ">=0.25.0",
    "uuid": ">=11.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.4.28",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  }
}
